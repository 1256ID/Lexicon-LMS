@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Components.Common
@rendermode InteractiveWebAssembly

@inject IParticipantsService ParticipantsService

@attribute [Authorize(Roles = "Student")]

<div class="card shadow-sm mb-5">
    <div class="card-header bg-light border-0 p-4">
        <h5 class="fw-bold mb-0 text-primary">
            <i class="bi bi-people me-2"></i>Course Participants
        </h5>
    </div>
    <div class="card-body p-0">
        <Loading Show="@isLoading" Message="Loading participants..." />

        @if (!isLoading)
        {
            @if (participants != null && participants.Any())
            {
                <!-- Teacher Section -->
                @if (teacher != null)
                {
                    <div class="border-bottom bg-light px-4 py-2">
                        <small class="text-muted fw-bold">TEACHER</small>
                    </div>
                    <div class="px-4 py-3 border-bottom">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 40px; height: 40px;">
                                <i class="bi bi-person-fill text-white"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">@teacher.Name</h6>
                                <small class="text-muted">@teacher.Email</small>
                            </div>
                            <span class="badge bg-primary ms-auto">Teacher</span>
                        </div>
                    </div>
                }

                <!-- Students Section -->
                @if (students.Any())
                {
                    <div class="border-bottom bg-light px-4 py-2">
                        <small class="text-muted fw-bold">CLASSMATES (@(students.Count() - 1))</small>
                    </div>

                    @foreach (var student in students.OrderBy(s => IsCurrentUser(s.Id) ? 0 : 1).ThenBy(s => s.Name))
                    {
                        <div class="px-4 py-3 @(student != students.Last() ? "border-bottom" : "")">
                            <div class="d-flex align-items-center">
                                <div class="@GetStudentAvatarClass(student.Id) rounded-circle d-flex align-items-center justify-content-center me-3"
                                     style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill text-white"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0">
                                        @student.Name
                                        @if (IsCurrentUser(student.Id))
                                        {
                                            <small class="text-muted">(You)</small>
                                        }
                                    </h6>
                                    <small class="text-muted">@student.Email</small>
                                </div>
                                <span class="badge @GetStudentBadgeClass(student.Id)">
                                    @GetStudentBadgeText(student.Id)
                                </span>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="text-center text-muted p-4">
                    <i class="bi bi-people fs-1 mb-2"></i>
                    <p class="mb-0">No participants in this course</p>
                </div>
            }
        }
    </div>

    <!-- Course Stats Footer -->
    @if (!isLoading && participants != null && participants.Any())
    {
        <div class="card-footer bg-light text-center">
            <small class="text-muted">
                <i class="bi bi-people-fill me-1"></i>
                Total: @participants.Count participants (@students.Count() students, 1 teacher)
            </small>
        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int CurrentUserId { get; set; }

    private List<ParticipantDto> participants = new();
    private ParticipantDto? teacher;
    private IEnumerable<ParticipantDto> students => participants.Where(p => p.Role == "Student");

    private bool isLoading = true;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUser();
        await LoadParticipants();
    }

    private async Task GetCurrentUser()
    {
        if (AuthenticationStateTask != null)
        {
            var authState = await AuthenticationStateTask;
            var userIdClaim = authState.User.FindFirst("sub") ?? authState.User.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                CurrentUserId = userId;
            }
        }
    }

    private async Task LoadParticipants()
    {
        try
        {
            isLoading = true;
            participants = await ParticipantsService.GetCourseParticipantsAsync(CourseId);
            teacher = participants.FirstOrDefault(p => p.Role == "Teacher");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading participants: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Helper methods
    private bool IsCurrentUser(int studentId) => studentId == CurrentUserId;

    private string GetStudentAvatarClass(int studentId) =>
        IsCurrentUser(studentId) ? "bg-warning" : "bg-success";

    private string GetStudentBadgeClass(int studentId) =>
        IsCurrentUser(studentId) ? "bg-warning" : "bg-light text-dark";

    private string GetStudentBadgeText(int studentId) =>
        IsCurrentUser(studentId) ? "You" : "Student";
}

@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Models
@rendermode InteractiveWebAssembly
@inject IParticipantsService ParticipantsService
@attribute [Authorize(Roles = "Teacher")]

<div class="card shadow-sm mb-5">
    <div class="card-header bg-light border-0 p-4">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-primary">
                <i class="bi bi-people me-2"></i>Course Participants
            </h5>
            <button class="btn btn-primary btn-sm" @onclick="ShowAddStudentModal">
                <i class="bi bi-person-plus me-1"></i>Add Student
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (isLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (participants != null && participants.Any())
        {
            <!-- Teacher Section -->
            @if (teacher != null)
            {
                <div class="border-bottom bg-light px-4 py-2">
                    <small class="text-muted fw-bold">TEACHER</small>
                </div>
                <div class="px-4 py-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px;">
                            <i class="bi bi-person-fill text-white"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">@teacher.Name</h6>
                            <small class="text-muted">@teacher.Email</small>
                        </div>
                        <span class="badge bg-primary ms-auto">Teacher</span>
                    </div>
                </div>
            }

            <!-- Students Section -->
            @if (students.Any())
            {
                <div class="border-bottom bg-light px-4 py-2">
                    <small class="text-muted fw-bold">STUDENTS (@students.Count())</small>
                </div>

                @foreach (var student in students)
                {
                    <div class="px-4 py-3 border-bottom">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <div class="bg-success rounded-circle d-flex align-items-center justify-content-center me-3"
                                     style="width: 40px; height: 40px;">
                                    <i class="bi bi-person-fill text-white"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">@student.Name</h6>
                                    <small class="text-muted">@student.Email</small>
                                   
                                </div>
                            </div>
                            <div>
                                <span class="badge bg-light text-dark me-2">Student</span>
                                <button class="btn btn-outline-danger btn-sm"
                                        @onclick="@(() => RemoveStudent(student.Id))"
                                        title="Remove from course"
                                        disabled="@isRemoving">
                                    @if (isRemoving && removingStudentId == student.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-dash"></i>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="text-center text-muted p-4">
                <i class="bi bi-people fs-1 mb-2"></i>
                <p class="mb-0">No participants in this course</p>
            </div>
        }
    </div>

    <!-- Course Stats Footer -->
    @if (participants != null && participants.Any())
    {
        <div class="card-footer bg-light text-center">
            <small class="text-muted">
                <i class="bi bi-people-fill me-1"></i>
                Total: @participants.Count participants (@students.Count() students, 1 teacher)
            </small>
        </div>
    }
</div>

<!-- Add Student Modal -->
@if (showAddModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Student to Course</h5>
                    <button type="button" class="btn-close" @onclick="HideAddStudentModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Search Student</label>
                        <input type="text" class="form-control" @bind="searchTerm" @oninput="OnSearchInput"
                               placeholder="Enter student name or email..." />
                    </div>

                    @if (isSearching)
                    {
                        <div class="text-center p-3">
                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                <span class="visually-hidden">Searching...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Searching students...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(searchTerm) && availableStudents.Any())
                    {
                        <div class="list-group">
                            @foreach (var student in availableStudents.Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@student.Name</h6>
                                        <small class="text-muted">@student.Email</small>
                                    </div>
                                    <button class="btn btn-outline-primary btn-sm"
                                            @onclick="@(() => AddStudent(student.Id))"
                                            disabled="@isAdding">
                                        @if (isAdding && addingStudentId == student.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        }
                                        else
                                        {
                                            <span>Add</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(searchTerm) && !isSearching)
                    {
                        <div class="text-muted text-center p-3">
                            <i class="bi bi-search"></i>
                            <p class="mb-0">No students found matching "@searchTerm"</p>
                        </div>
                    }
                    else if (string.IsNullOrEmpty(searchTerm))
                    {
                        <div class="text-muted text-center p-3">
                            <i class="bi bi-info-circle"></i>
                            <p class="mb-0">Start typing to search for students</p>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideAddStudentModal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public int CourseId { get; set; }

    private List<ParticipantDto> participants = new();
    private ParticipantDto? teacher;
    private IEnumerable<ParticipantDto> students => participants.Where(p => p.Role == "Student");
    private List<AvailableStudentDto> availableStudents = new();

    private bool isLoading = true;
    private bool showAddModal = false;
    private bool isSearching = false;
    private bool isAdding = false;
    private bool isRemoving = false;
    private int addingStudentId = 0;
    private int removingStudentId = 0;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadParticipants();
    }

    private async Task LoadParticipants()
    {
        try
        {
            isLoading = true;
            participants = await ParticipantsService.GetCourseParticipantsAsync(CourseId);
            teacher = participants.FirstOrDefault(p => p.Role == "Teacher");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading participants: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(searchTerm) || searchTerm.Length < 2)
        {
            availableStudents.Clear();
            return;
        }

        await SearchStudents();
    }

    private async Task SearchStudents()
    {
        try
        {
            isSearching = true;
            StateHasChanged();

            availableStudents = await ParticipantsService.SearchAvailableStudentsAsync(searchTerm, CourseId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching students: {ex.Message}");
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task AddStudent(int studentId)
    {
        try
        {
            isAdding = true;
            addingStudentId = studentId;
            StateHasChanged();

            var success = await ParticipantsService.AddStudentToCourseAsync(CourseId, studentId);

            if (success)
            {
                await LoadParticipants();
                await SearchStudents(); // Refresh available students
                HideAddStudentModal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding student: {ex.Message}");
        }
        finally
        {
            isAdding = false;
            addingStudentId = 0;
            StateHasChanged();
        }
    }

    private async Task RemoveStudent(int studentId)
    {
        try
        {
            isRemoving = true;
            removingStudentId = studentId;
            StateHasChanged();

            var success = await ParticipantsService.RemoveStudentFromCourseAsync(CourseId, studentId);

            if (success)
            {
                await LoadParticipants();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing student: {ex.Message}");
        }
        finally
        {
            isRemoving = false;
            removingStudentId = 0;
            StateHasChanged();
        }
    }

    private void ShowAddStudentModal()
    {
        showAddModal = true;
        searchTerm = "";
        availableStudents.Clear();
    }

    private void HideAddStudentModal()
    {
        showAddModal = false;
        searchTerm = "";
        availableStudents.Clear();
    }

    
}
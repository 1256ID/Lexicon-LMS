<!-- When you have your Module model, uncomment this:
<EditForm Model="@Module" OnValidSubmit="@HandleValidSubmit" class="needs-validation" novalidate>
    <DataAnnotationsValidator />
-->

<div class="card shadow-sm">
    <div class="card-header bg-light border-0 p-4">
        <h5 class="fw-bold mb-0 text-success">
            <i class="bi bi-file-text me-2"></i>@HeaderTitle
        </h5>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-12 mb-3">
                <div class="form-floating">
                    <input @bind="moduleName" class="form-control" id="moduleName" name="moduleName" placeholder="Module Name" />
                    <!-- With model: <InputText @bind-Value="Module.Name" class="form-control" id="moduleName" placeholder="Module Name" /> -->
                    <label for="moduleName">Module Name *</label>
                    <!-- With model: <ValidationMessage For="@(() => Module.Name)" class="text-danger small" /> -->
                </div>
            </div>

            <div class="col-12 mb-3">
                <div class="form-floating">
                    <textarea @bind="moduleDescription" class="form-control module-description" id="moduleDescription" name="moduleDescription"
                              placeholder="Module Description" style="height: 180px; min-height: 180px; resize: vertical;"></textarea>
                    <!-- With model: <InputTextArea @bind-Value="Module.Description" class="form-control module-description" id="moduleDescription" placeholder="Module Description" /> -->
                    <label for="moduleDescription">Module Description *</label>
                    <!-- With model: <ValidationMessage For="@(() => Module.Description)" class="text-danger small" /> -->
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="form-floating">
                    <input @bind="startDate" type="date" class="form-control" id="moduleStartDate" name="moduleStartDate" />
                    <!-- With model: <InputDate @bind-Value="Module.StartDate" class="form-control" id="moduleStartDate" /> -->
                    <label for="moduleStartDate">Start Date *</label>
                    <!-- With model: <ValidationMessage For="@(() => Module.StartDate)" class="text-danger small" /> -->
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="form-floating">
                    <input @bind="endDate" type="date" class="form-control" id="moduleEndDate" name="moduleEndDate" />
                    <!-- With model: <InputDate @bind-Value="Module.EndDate" class="form-control" id="moduleEndDate" /> -->
                    <label for="moduleEndDate">End Date *</label>
                    <!-- With model: <ValidationMessage For="@(() => Module.EndDate)" class="text-danger small" /> -->
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3" role="alert">
                <i class="bi bi-check-circle me-2"></i>@successMessage
            </div>
        }
    </div>

    <div class="card-footer bg-light border-0 p-4">
        <div class="d-flex justify-content-between">
            <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancel">
                <i class="bi bi-arrow-left me-2"></i>Cancel
            </button>
            <div>
                @if (ShowDeleteButton)
                {
                    <button type="button" class="btn btn-outline-danger me-2" @onclick="HandleDelete">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                }
                <button type="button" class="btn btn-success" @onclick="HandleSubmit" disabled="@isSubmitting">
                    <!-- With model: <button type="submit" class="btn btn-success" disabled="@isSubmitting"> -->
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-2"></i>
                    }
                    @SubmitButtonText
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Close EditForm when you have your model:
</EditForm>
-->
@code {
    // ===== COMPONENT PARAMETERS =====
    [Parameter] public string HeaderTitle { get; set; } = "Module Information";
    [Parameter] public string SubmitButtonText { get; set; } = "Save Module";
    [Parameter] public bool ShowDeleteButton { get; set; } = false;
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    // ===== PARAMETERS FOR PRE-FILLING =====
    [Parameter] public string? InitialModuleName { get; set; }
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public DateTime? InitialStartDate { get; set; }
    [Parameter] public DateTime? InitialEndDate { get; set; }

    // ===== FORM VARIABLES =====
    private string moduleName = "";
    private string moduleDescription = "";
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today.AddDays(14);

    // ===== STATE VARIABLES =====
    private bool isSubmitting = false;
    private string errorMessage = "";
    private string successMessage = "";

    // ===== INITIALIZATION =====
    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(InitialModuleName))
            moduleName = InitialModuleName;

        if (!string.IsNullOrEmpty(InitialDescription))
            moduleDescription = InitialDescription;

        if (InitialStartDate.HasValue)
            startDate = InitialStartDate.Value;

        if (InitialEndDate.HasValue)
            endDate = InitialEndDate.Value;
    }

    // ===== FORM METHODS (EXACTLY LIKE CourseForm) =====
    private void HandleSubmit()  // Synchronous, no async
    {
        if (string.IsNullOrWhiteSpace(moduleName))
        {
            errorMessage = "Module name is required";
            return;
        }

        if (endDate <= startDate)
        {
            errorMessage = "End date must be after start date";
            return;
        }

        errorMessage = "";
        OnSubmit.InvokeAsync();  
    }

    private void HandleCancel()  
    {
        OnCancel.InvokeAsync();
    }

    private void HandleDelete()  
    {
        OnDelete.InvokeAsync();
    }
}
@using LMS.Blazor.Client.Models

<div class="card shadow-sm">
    <div class="card-header bg-light border-0 p-4">
        <h5 class="fw-bold mb-0 text-purple">
            <i class="bi bi-calendar-event me-2"></i>@HeaderTitle
        </h5>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-12 mb-3">
                <div class="form-floating">
                    <input @bind="activityName" class="form-control" id="activityName" name="activityName" placeholder="Activity Name" />
                    <label for="activityName">Activity Name *</label>
                </div>
            </div>

            <div class="col-12 mb-3">
                <div class="form-floating">
                    <textarea @bind="activityDescription" class="form-control activity-description" id="activityDescription" name="activityDescription"
                              placeholder="Activity Description" style="height: 180px; min-height: 180px; resize: vertical;"></textarea>
                    <label for="activityDescription">Activity Description *</label>
                </div>
            </div>

            <div class="col-12 mb-3">
                <div class="form-floating">
                    <select @bind="activityType" class="form-select" id="activityType" name="activityType">
                        <option value="">Select Activity Type</option>
                        <option value="Lecture">Lecture</option>
                        <option value="Exercise">Exercise</option>
                        <option value="Workshop">Workshop</option>
                        <option value="Assignment">Assignment</option>
                        <option value="Other">Other</option>
                    </select>
                    <label for="activityType">Activity Type *</label>
                </div>
            </div>

            <div class="col-12 col-md-3 mb-3">
                <div class="form-floating">
                    <input @bind="startDate" type="datetime-local" class="form-control" id="startDate" name="startDate" />
                    <label for="startDate">Start Date & Time *</label>
                </div>
            </div>

            <div class="col-12 col-md-3 mb-3">
                <div class="form-floating">
                    <input @bind="endDate" type="datetime-local" class="form-control" id="endDate" name="endDate" />
                    <label for="endDate">End Date & Time *</label>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success mt-3" role="alert">
                <i class="bi bi-check-circle me-2"></i>@SuccessMessage
            </div>
        }
    </div>

    <div class="card-footer bg-light border-0 p-4">
        <div class="d-flex justify-content-between">
            <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancel">
                <i class="bi bi-arrow-left me-2"></i>Cancel
            </button>
            <div>
                @if (ShowDeleteButton)
                {
                    <button type="button" class="btn btn-outline-danger me-2" @onclick="HandleDelete">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                }
                <button type="button" class="btn" style="background-color: #6f42c1; color: white;" @onclick="HandleSubmit" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-2"></i>
                    }
                    @SubmitButtonText
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    // COMPONENT PARAMETERS
    [Parameter] public string HeaderTitle { get; set; } = "Activity Information";
    [Parameter] public string SubmitButtonText { get; set; } = "Save Activity";
    [Parameter] public bool ShowDeleteButton { get; set; } = false;

    // EVENT CALLBACKS - UPDATED TO PASS DATA
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<ActivityFormData> OnSubmit { get; set; }

    // INITIAL VALUES (for edit mode)
    [Parameter] public string? InitialActivityName { get; set; }
    [Parameter] public string? InitialDescription { get; set; }
    [Parameter] public string? InitialActivityType { get; set; }
    [Parameter] public DateTime? InitialStartDate { get; set; }
    [Parameter] public DateTime? InitialEndDate { get; set; }

    // STATE (controlled by parent)
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }

    // FORM FIELDS
    private string activityName = "";
    private string activityDescription = "";
    private string activityType = "";
    private DateTime startDate = DateTime.Today.AddHours(9); // Default to 9 AM today
    private DateTime endDate = DateTime.Today.AddHours(17);  // Default to 5 PM today

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(InitialActivityName))
            activityName = InitialActivityName;

        if (!string.IsNullOrEmpty(InitialDescription))
            activityDescription = InitialDescription;

        if (!string.IsNullOrEmpty(InitialActivityType))
            activityType = InitialActivityType;

        if (InitialStartDate.HasValue)
            startDate = InitialStartDate.Value;

        if (InitialEndDate.HasValue)
            endDate = InitialEndDate.Value;
    }

    private async Task HandleSubmit()
    {
        // Basic validation
        if (string.IsNullOrWhiteSpace(activityName) ||
            string.IsNullOrWhiteSpace(activityDescription) ||
            string.IsNullOrWhiteSpace(activityType) ||
            endDate <= startDate)
        {
            return;
        }

        // Create form data object
        var formData = new ActivityFormData
        {
            Name = activityName.Trim(),
            Description = activityDescription.Trim(),
            TypeName = activityType,
            StartDate = startDate,
            EndDate = endDate
        };

        await OnSubmit.InvokeAsync(formData);
    }

    private async Task HandleCancel() => await OnCancel.InvokeAsync();
    private async Task HandleDelete() => await OnDelete.InvokeAsync();
}
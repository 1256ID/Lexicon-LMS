@using LMS.Blazor.Client.Models

<div class="card shadow-sm @(FullHeight ? "h-100" : "")">
    <div class="card-header bg-light border-0 p-2">
        <small class="fw-bold text-primary">
            <i class="bi @IconClass me-1"></i>@Title
        </small>
    </div>
    <div class="card-body p-2">
        @if (displayItems.Any())
        {
            @if (IsListFormat)
            {
                <!-- List format - for students -->
                <ul class="list-group list-group-flush">
                    @foreach (var item in displayItems.Take(MaxItems))
                    {
                        <li class="list-group-item px-0 py-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold small">@item.Title</div>
                                    @if (!string.IsNullOrEmpty(item.Subtitle))
                                    {
                                        <small class="text-muted">@item.Subtitle</small>
                                    }
                                </div>
                                @if (ShowBadges && item.Date != null)
                                {
                                    <span class="badge @item.BadgeClass small">
                                        @item.Date?.ToString("MM/dd")
                                    </span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <!-- Flex format - for teachers -->
                @foreach (var item in displayItems.Take(MaxItems))
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="fw-bold small">@item.Title</div>
                            @if (!string.IsNullOrEmpty(item.Subtitle))
                            {
                                <small class="text-muted">@item.Subtitle</small>
                            }
                        </div>
                        <div class="text-end">
                            @if (ShowBadges && item.Date != null)
                            {
                                <span class="badge @item.BadgeClass small">
                                    @item.Date?.ToString("MM/dd")
                                </span>
                            }
                        </div>
                    </div>
                }
            }

            @if (ShowViewAllButton && displayItems.Count() > MaxItems)
            {
                <div class="text-end mt-2">
                    <button class="btn btn-outline-primary btn-sm" @onclick="OnViewAllClick">
                        @ViewAllText <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="bi @EmptyIcon fs-3 mb-2"></i>
                <p class="mb-0">@EmptyMessage</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Upcoming Items";
    [Parameter] public string IconClass { get; set; } = "bi-alarm";
    [Parameter] public int MaxItems { get; set; } = 5;
    [Parameter] public bool FullHeight { get; set; } = false;
    [Parameter] public bool IsListFormat { get; set; } = false;
    [Parameter] public bool ShowBadges { get; set; } = true;
    [Parameter] public bool ShowViewAllButton { get; set; } = false;
    [Parameter] public string ViewAllText { get; set; } = "View All";
    [Parameter] public string EmptyMessage { get; set; } = "No upcoming items";
    [Parameter] public string EmptyIcon { get; set; } = "bi-check-circle";
    [Parameter] public EventCallback OnViewAllClick { get; set; }

    // Parameters for both usage modes
    [Parameter] public IEnumerable<object>? Items { get; set; }
    [Parameter] public List<CourseVM>? Courses { get; set; }

    // Conversion functions for Student mode
    [Parameter] public Func<object, string>? GetItemTitle { get; set; }
    [Parameter] public Func<object, string>? GetItemSubtitle { get; set; }
    [Parameter] public Func<object, DateTime?>? GetItemDate { get; set; }
    [Parameter] public Func<object, string>? GetBadgeClass { get; set; }

    private List<DisplayItem> displayItems = new();

    protected override void OnParametersSet()
    {
        displayItems.Clear();

        // Student Mode: use Items with conversion functions
        if (Items != null && Items.Any() && GetItemTitle != null)
        {
            foreach (var item in Items)
            {
                displayItems.Add(new DisplayItem
                {
                    Title = GetItemTitle(item),
                    Subtitle = GetItemSubtitle?.Invoke(item) ?? "",
                    Date = GetItemDate?.Invoke(item),
                    BadgeClass = GetBadgeClass?.Invoke(item) ?? "bg-primary"
                });
            }
        }
        // Teacher Mode: use Courses to generate deadlines
        else if (Courses != null && Courses.Any())
        {
            var courseDeadlines = new List<DisplayItem>();

            foreach (var course in Courses)
            {
                var endDate = course.EndDate;
                var daysUntil = (endDate - DateTime.Today).TotalDays;

                var badgeClass = "bg-primary";
                if (daysUntil <= 7) badgeClass = "bg-warning";
                if (daysUntil <= 3) badgeClass = "bg-danger";

                courseDeadlines.Add(new DisplayItem
                {
                    Title = $"Course: {course.Name}",
                    Subtitle = $"End Date",
                    Date = endDate,
                    BadgeClass = badgeClass
                });
            }

            displayItems = courseDeadlines.OrderBy(d => d.Date).ToList();
        }
    }

    public class DisplayItem
    {
        public string Title { get; set; } = string.Empty;
        public string Subtitle { get; set; } = string.Empty;
        public DateTime? Date { get; set; }
        public string BadgeClass { get; set; } = "bg-primary";
    }
}
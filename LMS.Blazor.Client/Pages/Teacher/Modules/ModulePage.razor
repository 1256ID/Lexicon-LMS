@page "/teacher/course/{CourseId:int}/module/{ModuleId:int}"
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services
@inject NavigationManager Nav
@inject NavigationStateService NavState

@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">

            <div class="mb-4">
                <h2 class="fw-bold text-primary">@ModuleName</h2>
                <p class="text-muted"><i class="bi bi-calendar-event me-2 text-secondary"></i> Start: 2025/09/14</p>
            </div>

            <div class="d-flex gap-2 flex-wrap justify-content-center mb-5">
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Activities ? "active" : "")" @onclick="() => SelectTab(Tab.Activities)">Activities</button>
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")" @onclick="() => SelectTab(Tab.Documents)">Documents</button>
            </div>

            <div class="tab-content">
                @switch (SelectedTab)
                {
                    case Tab.Activities:
                        <ModuleActivities ModuleId="@ModuleId" />
                        break;
                    case Tab.Documents:
                        <ModuleDocuments ModuleId="@ModuleId" />
                        break;
                }
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int ModuleId { get; set; }

    private enum Tab { Activities, Documents }
    private Tab SelectedTab = Tab.Activities;

    private string ModuleName => NavState.CurrentModuleName ?? $"Module {ModuleId}";

    protected override void OnInitialized()
    {
        NavState.SetModule(ModuleId, ModuleName);
        NavState.ClearActivity();
    }

    private void SelectTab(Tab tab) => SelectedTab = tab;
}

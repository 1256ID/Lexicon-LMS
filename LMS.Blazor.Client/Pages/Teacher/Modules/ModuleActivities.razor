@using LMS.Blazor.Client.Services
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Components.Cards
@using LMS.Blazor.Client.Services.Interfaces
@inject IActivityService ActivityService
@inject NavigationManager Nav
@inject NavigationStateService NavState

<div class="row">
    @foreach (var a in ActivitiesList)
    {
        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
            <ActivityCard Activity="a"
                          OnOpen="OpenActivity"
                          OnEdit="EditActivity" />
        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int ModuleId { get; set; }

    private List<ActivityVM>? ActivitiesList;

    protected override async Task OnInitializedAsync()
    {
        var activities = await ActivityService.GetActivitiesByModuleIdAsync(ModuleId);
        ActivitiesList = activities.ToList();
    }

    private void OpenActivity(ActivityVM a)
    {
        var moduleName = NavState.CurrentModuleName ?? $"Module {ModuleId}";
        NavState.SetActivity(ModuleId, moduleName, a.Id, a.Title);
        Nav.NavigateTo($"/teacher/course/{CourseId}/module/{ModuleId}/activity/{a.Id}");
    }

    private void EditActivity(int id)
    {
        Nav.NavigateTo($"/teacher/course/{CourseId}/module/{ModuleId}/activity/edit/{id}");
    }
}






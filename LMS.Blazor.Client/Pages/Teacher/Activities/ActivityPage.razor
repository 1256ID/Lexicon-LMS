@page "/teacher/course/{CourseId:int}/module/{ModuleId:int}/activity/{ActivityId:int}"
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services
@inject NavigationStateService NavState

@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">

            <div class="mb-4">
                <h2 class="fw-bold text-primary">@ActivityName</h2>
                <p class="text-muted"><i class="bi bi-calendar-event me-2 text-secondary"></i> Start: 2025/09/18</p>
            </div>

            <div class="d-flex gap-2 flex-wrap justify-content-center mb-5">
                <button class="btn btn-outline-primary @(SelectedTab == Tab.View ? "active" : "")" @onclick="() => SelectTab(Tab.View)">View</button>
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")" @onclick="() => SelectTab(Tab.Documents)">Documents</button>
            </div>

            <div class="tab-content">
                @switch (SelectedTab)
                {
                    case Tab.View:
                        <ActivityView ModuleId="@ModuleId" ActivityId="@ActivityId" />
                        break;
                    case Tab.Documents:
                        <ActivityDocuments ModuleId="@ModuleId" ActivityId="@ActivityId" />
                        break;
                }
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }

    private enum Tab { View, Documents }
    private Tab SelectedTab = Tab.View;

    private string ActivityName => NavState.CurrentActivityName ?? $"Activity {ActivityId}";

    protected override void OnInitialized()
    {
        var moduleName = NavState.CurrentModuleName ?? $"Module {ModuleId}";
        NavState.SetActivity(ModuleId, moduleName, ActivityId, ActivityName);
    }

    private void SelectTab(Tab tab) => SelectedTab = tab;
}

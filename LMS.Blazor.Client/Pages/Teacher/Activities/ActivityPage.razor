@page "/teacher/course/{CourseId:int}/module/{ModuleId:int}/activity/{ActivityId:int}"

@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Components.Info
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Tabs
@using LMS.Blazor.Client.Models
@inject NavigationStateService NavState
@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-4">
                <h2 class="fw-bold activity-text-purple">@ActivityName</h2>
                <p class="text-muted">
                    <i class="bi bi-calendar-event me-2 text-secondary"></i>
                    Start: 2025/09/18
                </p>
            </div>
            
            <!-- Tab Navigation Component -->
            <TabNavigation TTabType="Tab" 
                       SelectedTab="SelectedTab" 
                       OnTabChanged="OnTabChanged"
                       ShowDetailsButton="false"
                       Buttons="TabButtons" />
                       
            <div class="tab-content">
                @switch (SelectedTab)
                {
                    case Tab.Info:
                        <Info ActivityId="@ActivityId" />
                        break;
                    case Tab.Documents:
                        <ActivityDocuments ModuleId="@ModuleId" ActivityId="@ActivityId" />
                        break;
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }
    
    // Tab enumeration for activity navigation
    private enum Tab { Info, Documents }
    private Tab SelectedTab = Tab.Info; // Start with Info tab
    private string ActivityName => NavState.CurrentActivityName ?? $"Activity {ActivityId}";
    
    // Tab button configuration for the navigation component
    private List<TabNavigation<Tab>.TabButton<Tab>> TabButtons = new()
    {
        new() { Label = "Info", TabValue = Tab.Info },
        new() { Label = "Documents", TabValue = Tab.Documents }
    };
    
    // Handle tab change event from navigation component
    private async Task OnTabChanged(Tab newTab)
    {
        SelectedTab = newTab;
    }
    
    // Initialize activity navigation state
    protected override void OnInitialized()
    {
        var moduleName = NavState.CurrentModuleName ?? $"Module {ModuleId}";
        var activityName = NavState.CurrentActivityName ?? $"Activity {ActivityId}";
        NavState.SetCourse(CourseId, NavState.CurrentCourseName ?? $"Course {CourseId}");
        NavState.SetActivity(ModuleId, moduleName, ActivityId, activityName);
    }
}


@page "/teacher/course/{CourseId:int}/module/{ModuleId:int}/activity/edit/{ActivityId:int}"

@rendermode InteractiveWebAssembly
@inject NavigationManager Navigation
@inject IActivityService ActivityService
@inject IModuleService ModuleService
@inject ICourseService CourseService
@inject IJSRuntime JSRuntime
@using LMS.Blazor.Client.Components.Forms
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Edit Activity</PageTitle>

<div class="content">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-5">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/teacher/courses" class="text-decoration-none">
                    <i class="bi bi-book me-1"></i>Courses
                </a>
            </li>
            @if (course != null)
            {
                <li class="breadcrumb-item">
                    <a href="/teacher/course/@CourseId" class="text-decoration-none">
                        @course.Name
                    </a>
                </li>
            }
            @if (module != null)
            {
                <li class="breadcrumb-item">
                    <a href="/teacher/course/@CourseId/module/@ModuleId" class="text-decoration-none">
                        @module.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active">Edit Activity</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-12">
            @if (isLoading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (activity == null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Activity not found.
                </div>
            }
            else
            {
                @if (module != null && course != null)
                {
                    <div class="mb-3">
                        <h4 class="text-muted">Editing activity in: <strong>@module.Name</strong></h4>
                        <small class="text-muted">Course: @course.Name</small>
                    </div>
                }

                <ActivityForm HeaderTitle="Edit Activity"
                              SubmitButtonText="Update Activity"
                              ShowDeleteButton="true"
                              InitialActivityName="@activity.Name"
                              InitialDescription="@activity.Description"
                              InitialActivityType="@activity.TypeName"
                              InitialStartDate="@activity.StartDate"
                              InitialEndDate="@activity.EndDate"
                              OnCancel="@HandleCancel"
                              OnSubmit="@HandleSubmit"
                              OnDelete="@HandleDelete"
                              ErrorMessage="@errorMessage"
                              SuccessMessage="@successMessage"
                              IsSubmitting="@isSubmitting" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }

    // Component state
    private ActivityVM? activity;
    private ModuleVM? module;
    private CourseVM? course;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var activityTask = ActivityService.GetActivityByIdAsync(ActivityId);
            var moduleTask = ModuleService.GetModuleByIdAsync(ModuleId);
            var courseTask = CourseService.GetCourseByIdAsync(CourseId);

            await Task.WhenAll(activityTask, moduleTask, courseTask);

            activity = await activityTask;
            module = await moduleTask;
            course = await courseTask;

            // Validate data relationships
            if (activity == null)
            {
                errorMessage = $"Activity with ID {ActivityId} not found";
            }
            else if (activity.ModuleId != ModuleId)
            {
                errorMessage = "Activity does not belong to the specified module";
                activity = null;
            }
            else if (module == null)
            {
                errorMessage = $"Module with ID {ModuleId} not found";
            }
            else if (module.CourseId != CourseId)
            {
                errorMessage = "Module does not belong to the specified course";
                module = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            activity = null;
            module = null;
            course = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit(ActivityFormData formData)
    {
        if (activity == null) return;

        try
        {
            isSubmitting = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            StateHasChanged();

            // Update activity properties
            activity.Name = formData.Name;
            activity.Description = formData.Description;
            activity.TypeName = formData.TypeName;
            activity.StartDate = formData.StartDate;
            activity.EndDate = formData.EndDate;

            var updatedActivity = await ActivityService.UpdateActivityAsync(activity);

            successMessage = "Activity updated successfully!";
            StateHasChanged();

            await Task.Delay(1500);
            Navigation.NavigateTo($"/teacher/course/{CourseId}/module/{ModuleId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating activity: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void HandleCancel()
    {
        Navigation.NavigateTo($"/teacher/course/{CourseId}/module/{ModuleId}");
    }

    private async Task HandleDelete()
    {
        if (activity == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete the activity '{activity.Name}'? This action cannot be undone.");

        if (!confirmed) return;

        try
        {
            var success = await ActivityService.DeleteActivityAsync(activity.Id);

            if (success)
            {
                Navigation.NavigateTo($"/teacher/course/{CourseId}/module/{ModuleId}");
            }
            else
            {
                errorMessage = "Failed to delete activity";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting activity: {ex.Message}";
        }
    }
}
@page "/teacher/course/{CourseId:int}/module/{ModuleId:int}/activity/edit/{ActivityId:int}"

@rendermode InteractiveWebAssembly
@inject NavigationManager Navigation
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@using LMS.Blazor.Client.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Edit Activity</PageTitle>

<div class="content">
    <!-- Breadcrumb with full hierarchy -->
    <nav aria-label="breadcrumb" class="mb-5">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/teacher/courses/@CourseId" class="text-decoration-none">
                    <i class="bi bi-book me-1"></i>@courseName
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/teacher/courses/@CourseId/modules/@ModuleId" class="text-decoration-none">
                    @moduleName
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/teacher/courses/@CourseId/modules/@ModuleId/activities" class="text-decoration-none">
                    @activityName
                </a>
            </li>
            <li class="breadcrumb-item active">Edit Activity</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-12">
            <!-- EDIT MODE: Pre-filled with User Research activity data -->
            <ActivityForm HeaderTitle="Edit Activity"
                          SubmitButtonText="Update Activity"
                          ShowDeleteButton="true"
                          InitialActivityName="User Research Methods"
                          InitialDescription="Learn various user research techniques including interviews, surveys, and usability testing. This activity will help you understand user needs and validate design decisions."
                          InitialActivityType="Assignment"
                          InitialStartDate="@DateTime.Today.AddDays(-3)"
                          InitialEndDate="@DateTime.Today.AddDays(4)"
                          OnCancel="@HandleCancel"
                          OnSubmit="@HandleSubmit"
                          OnDelete="@HandleDelete" />

            <!-- With Activity model:
            <ActivityForm Activity="@activity"
                         OnValidSubmit="@HandleSubmit"
                         OnCancel="@HandleCancel"
                         OnDelete="@HandleDelete"
                         HeaderTitle="Edit Activity"
                         HeaderIcon="bi-pencil"
                         SubmitButtonText="Update Activity"
                         SubmitIcon="bi-check-lg"
                         ShowDeleteButton="true"
                         ErrorMessage="@errorMessage"
                         SuccessMessage="@successMessage"
                         IsSubmitting="@isSubmitting" />
            -->
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }

    private string courseName = "Introduction to UI/UX Design"; 
    private string moduleName = "Wireframing and Prototyping"; 
    private string activityName = "User Research Methods";


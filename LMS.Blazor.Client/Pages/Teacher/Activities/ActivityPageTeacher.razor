@page "/teacher/course/{CourseId:int}/module/{ModuleId:int}/activity/{ActivityId:int}"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject NavigationStateService NavState
@inject IActivityService ActivityService
@inject IModuleService ModuleService
@inject ICourseService CourseService
@inject NavigationManager Nav
@attribute [Authorize(Roles = "Teacher")]

<Loading Show="@isLoading" Message="Loading activity..." />

@if (!isLoading)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-10 mx-auto">

                <div class="mb-4">
                    <h2 class="fw-bold activity-text-purple">@ActivityName</h2>
                    <p class="text-muted">
                        <i class="bi bi-calendar-event me-2 text-secondary"></i> Start: @ActivityStartDate.ToString("yyyy/MM/dd")
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap justify-content-center mb-5">
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.View ? "active" : "")"
                            @onclick="() => SelectTab(Tab.View)">View</button>
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")"
                            @onclick="() => SelectTab(Tab.Documents)">Documents</button>
                </div>

                <div class="tab-content">
                    @switch (SelectedTab)
                    {
                        case Tab.View:
                            <ActivityViewTeacher ModuleId="@ModuleId" ActivityId="@ActivityId" />
                            break;
                        case Tab.Documents:
                            <ActivityDocumentsTeacher ModuleId="@ModuleId" ActivityId="@ActivityId" />
                            break;
                    }
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }

    private enum Tab { View, Documents }
    private Tab SelectedTab = Tab.View;

    private bool isLoading = true;
    private string ActivityName = string.Empty;
    private DateTime ActivityStartDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            // Dynamisk hämtning av activity info
            var module = await ModuleService.GetModuleByIdAsync(ModuleId);
            var activity = await ActivityService.GetActivityByIdAsync(ActivityId);

            ActivityName = activity?.Name ?? $"Activity {ActivityId}";
            ActivityStartDate = activity?.StartDate ?? DateTime.Today;

            var course = await CourseService.GetCourseByIdAsync(CourseId);
            NavState.SetCourse(CourseId, course?.Name ?? $"Course {CourseId}");
            NavState.SetActivity(ModuleId, module?.Name ?? $"Module {ModuleId}", ActivityId, ActivityName);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading activity: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectTab(Tab tab) => SelectedTab = tab;
}

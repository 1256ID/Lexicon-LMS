@using LMS.Blazor.Client.Components.Common
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Teacher")]

<Loading Show="@isLoading" Message="Loading documents..." />

@if (!isLoading)
{
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header">Course Documents</div>
                <ul class="list-group list-group-flush">
                    @foreach (var d in Docs)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@d.Title</span>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => Select(d.Id)">View</button>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card h-100">
                <div class="card-header">Preview</div>
                <div class="card-body">
                    @if (SelectedDoc is null)
                    {
                        <em>Select a document…</em>
                    }
                    else
                    {
                        <h5>@SelectedDoc.Title</h5>
                        <p class="text-muted">(@SelectedDoc.FileName)</p>
                        <hr />
                        <p>Here you render the document viewer (pdf/embed/markdown etc.).</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CourseId { get; set; }
    private bool isLoading = true;

    private record DocVm(int Id, string Title, string FileName);
    private List<DocVm> Docs = new()
    {
        new(10, "Syllabus", "course-syllabus.pdf"),
        new(11, "Setup Guide", "setup.md"),
        new(12, "Project Brief", "project.pdf")
    };

    private DocVm? SelectedDoc;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            await Task.Delay(200); // simulera async-data fetch om du vill
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Documents: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Select(int id) => SelectedDoc = Docs.First(x => x.Id == id);
}

@page "/teacher/course/edit/{CourseId:int}"

@inject NavigationManager Navigation
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime

@using LMS.Blazor.Client.Components.Forms
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Edit Course</PageTitle>

<div class="content">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-5">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/teacher/courses" class="text-decoration-none">
                    <i class="bi bi-book me-1"></i>Courses
                </a>
            </li>
            <li class="breadcrumb-item active">Edit Course</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-12">
            <!-- EDIT MODE: with example -  -->
            <CourseForm HeaderTitle="Edit Course"
                       SubmitButtonText="Update Course"
                       ShowDeleteButton="true"
                       InitialCourseName="Introduction to UI/UX Design"
                       InitialDescription="Learn the fundamentals of user interface and user experience design. This course covers design principles, wireframing, prototyping, and usability testing."
                       InitialStartDate="@DateTime.Today.AddDays(-15)"
                       OnCancel="@HandleCancel"
                       OnSubmit="@HandleSubmit"
                       OnDelete="@HandleDelete" />

            <!-- EDIT MODE: with Course model
            <CourseForm Course="@course"
                        OnValidSubmit="@HandleSubmit"
                        OnCancel="@HandleCancel"
                        OnDelete="@HandleDelete"
                        HeaderTitle="Edit Course"
                        HeaderIcon="bi-pencil"
                        SubmitButtonText="Update Course"
                        SubmitIcon="bi-check-lg"
                        ShowDeleteButton="true"
                        ErrorMessage="@errorMessage"
                        SuccessMessage="@successMessage"
                        IsSubmitting="@isSubmitting" />  -->
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }


@using LMS.Blazor.Client.Services
@inject NavigationManager Nav
@inject NavigationStateService NavState

<div class="row">
    @foreach (var m in Modules)
    {
        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
            <div class="card h-100 shadow-sm hover-card" style="border-radius: 0.8rem; transition: all 0.3s ease;">
                <div class="card-body d-flex flex-column p-4" style="cursor: pointer;" @onclick="() => OpenModule(m)">
                    <h5 class="card-title fw-bold mb-3 border-bottom pb-2 text-primary">@m.Title</h5>
                    <p class="card-text flex-grow-1">@m.Description</p>
                    <div class="mt-auto pt-3">
                        <small class="text-muted">📅 @m.StartDate.ToShortDateString() → @m.EndDate.ToShortDateString()</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private record ModuleVm(int Id, string Title, string Description, DateTime StartDate, DateTime EndDate);

    private List<ModuleVm> Modules = new()
    {
        new(1, "Introduction", "Intro to course", DateTime.Parse("2025-08-14"), DateTime.Parse("2025-08-20")),
        new(2, "C# Basics", "Learn C#", DateTime.Parse("2025-08-21"), DateTime.Parse("2025-08-28")),
        new(3, "Web API", "APIs in depth", DateTime.Parse("2025-08-29"), DateTime.Parse("2025-09-05"))
    };

    private void OpenModule(ModuleVm m)
    {
        NavState.SetModule(m.Id, m.Title);
        Nav.NavigateTo($"/teacher/course/{CourseId}/module/{m.Id}");
    }
}

@code {
    [Parameter] public int CourseId { get; set; }
    private CourseVM Course;
    private enum Tab { Modules, Documents, Participants, Schedule }
    private Tab SelectedTab = Tab.Modules;

    private string CourseName => NavState.CurrentCourseName ?? $"Course {CourseId}";

    private void SelectTab(Tab tab) => SelectedTab = tab;

    protected override async Task OnInitializedAsync()
    {
        NavState.SetCourse(CourseId, CourseName);

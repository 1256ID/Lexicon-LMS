@page "/teacher/course/{CourseId:int}"

@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Components.Participants
@using LMS.Blazor.Client.Components.Tabs
@using LMS.Blazor.Client.Components.Info
@using Microsoft.AspNetCore.Authorization
@inject ICourseService CourseService
@inject NavigationStateService NavState
@inject NavigationManager Nav
@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap">
                    <div>
                        <h2 class="fw-bold text-course mb-1">@course?.Name</h2>
                        <p class="text-muted mb-0">
                            <i class="bi bi-calendar-event me-2 text-secondary"></i>
                            Start: @course?.StartDate.ToString("yyyy/MM/dd")
                        </p>
                    </div>
                    <div>
                        <button type="button"
                                class="btn btn-success d-flex align-items-center px-3 py-2 shadow-sm"
                                @onclick="CreateNewModule"
                                disabled="@isLoading">
                            <i class="bi bi-plus-circle me-2"></i>New Module
                        </button>
                    </div>
                </div>
            </div>

            <!-- Loading component -->
            <Loading Show="@isLoading" Message="Loading course details..." />

            @if (!isLoading)
            {
                @if (course != null)
                {
                    <!-- Tab Navigation Component -->
                    <TabNavigation TTabType="Tab"
                                   SelectedTab="SelectedTab"
                                   OnTabChanged="OnTabChanged"
                                   Buttons="TabButtons" />

                    <!-- Tab Content -->
                    <div class="tab-content">
                        @switch (SelectedTab)
                        {
                            case Tab.Info:
                                <Info CourseId="@CourseId" />
                                break;
                            case Tab.Modules:
                                <CourseModulesTeacher CourseId="@CourseId" />
                                break;
                            case Tab.Documents:
                                <CourseDocumentsTeacher CourseId="@CourseId" />
                                break;
                            case Tab.Participants:
                                <CourseParticipantsTeacher CourseId="@CourseId" />
                                break;
                            case Tab.Schedule:
                                <CourseScheduleTeacher CourseId="@CourseId" />
                                break;
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted p-4">
                        <i class="bi bi-journal-x fs-1 mb-2"></i>
                        <p class="mb-0">Course not found</p>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private CourseVM? course;
    private bool isLoading = true;

    private enum Tab { Info, Modules, Documents, Participants, Schedule }
    private Tab SelectedTab = Tab.Modules;

    // Tab button configuration for the navigation component
    private List<TabNavigation<Tab>.TabButton<Tab>> TabButtons = new()
    {
        new() { Label = "Info", TabValue = Tab.Info },
        new() { Label = "Modules", TabValue = Tab.Modules },
        new() { Label = "Documents", TabValue = Tab.Documents },
        new() { Label = "Participants", TabValue = Tab.Participants },
        new() { Label = "Schedule", TabValue = Tab.Schedule }
    };

    protected override async Task OnInitializedAsync()
    {
        NavState.ClearModule();
        NavState.ClearActivity();

        try
        {
            isLoading = true;
            course = await CourseService.GetCourseByIdAsync(CourseId);

            if (course != null)
            {
                NavState.SetCourse(course.Id, course.Name);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading course: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // Handle tab change event from navigation component
    private async Task OnTabChanged(Tab newTab)
    {
        SelectedTab = newTab;
    }

    private void CreateNewModule()
    {
        var url = $"/teacher/course/{CourseId}/module/new";
        Console.WriteLine($"Navigating to: {url}");
        Nav.NavigateTo(url);
    }
}
@page "/teacher/course/{CourseId:int}"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Components.Participants
@using Microsoft.AspNetCore.Authorization
@inject ICourseService CourseService
@inject NavigationStateService NavState
@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-4">
                <h2 class="fw-bold text-course">@course?.Name</h2>
                <p class="text-muted">
                    <i class="bi bi-calendar-event me-2 text-secondary"></i>
                    Start: @course?.StartDate.ToString("yyyy/MM/dd")
                </p>
            </div>

            <!-- Loading component -->
            <Loading Show="@isLoading" Message="Loading course details..." />

            @if (!isLoading)
            {
                @if (course != null)
                {
                    <!-- Tabs -->
                    <div class="d-flex gap-2 flex-wrap justify-content-center mb-5">
                        <button class="btn btn-outline-primary @(SelectedTab == Tab.Modules ? "active" : "")"
                                @onclick="() => SelectTab(Tab.Modules)">
                            Modules
                        </button>
                        <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")"
                                @onclick="() => SelectTab(Tab.Documents)">
                            Documents
                        </button>
                        <button class="btn btn-outline-primary @(SelectedTab == Tab.Participants ? "active" : "")"
                                @onclick="() => SelectTab(Tab.Participants)">
                            Participants
                        </button>
                        <button class="btn btn-outline-primary @(SelectedTab == Tab.Schedule ? "active" : "")"
                                @onclick="() => SelectTab(Tab.Schedule)">
                            Schedule
                        </button>
                    </div>

                    <!-- Tab Content -->
                    <div class="tab-content">
                        @switch (SelectedTab)
                        {
                            case Tab.Modules:
                                <CourseModulesTeacher CourseId="@CourseId" />
                                break;
                            case Tab.Documents:
                                <CourseDocumentsTeacher CourseId="@CourseId" />
                                break;
                            case Tab.Participants:
                                <CourseParticipantsTeacher CourseId="@CourseId" />
                                break;
                            case Tab.Schedule:
                                <CourseScheduleTeacher CourseId="@CourseId" />
                                break;
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted p-4">
                        <i class="bi bi-journal-x fs-1 mb-2"></i>
                        <p class="mb-0">Course not found</p>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private CourseVM? course;
    private bool isLoading = true;

    private enum Tab { Modules, Documents, Participants, Schedule }
    private Tab SelectedTab = Tab.Modules;

    protected override async Task OnInitializedAsync()
    {
        NavState.ClearModule();
        NavState.ClearActivity();

        try
        {
            isLoading = true;
            course = await CourseService.GetCourseByIdAsync(CourseId);

            if (course != null)
            {
                NavState.SetCourse(course.Id, course.Name);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading course: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    private void SelectTab(Tab tab) => SelectedTab = tab;
}

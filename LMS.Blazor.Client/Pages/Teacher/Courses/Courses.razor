@page "/teacher/course"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Components.Cards
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Components.Common
@using Microsoft.AspNetCore.Authorization
@inject ICourseService CourseService
@inject NavigationManager Nav
@inject NavigationStateService NavState
@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-5 text-center">
                <h2 class="fw-bold text-course">Available Courses</h2>
                <p class="text-muted">Browse, manage and edit your courses</p>
            </div>

            <Loading Show="@isLoading" Message="Loading courses..." />

            @if (!isLoading)
            {
                @if (CoursesList != null && CoursesList.Any())
                {
                    <div class="row">
                        @foreach (var c in CoursesList)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <CourseCard Course="c"
                                            OnOpen="OpenCourse"
                                            OnEdit="EditCourse" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted p-4">
                        <i class="bi bi-journal-x fs-1 mb-2"></i>
                        <p class="mb-0">No courses available</p>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<CourseVM> CoursesList = new();
    private bool isLoading = true;

    private void OpenCourse(CourseVM c)
    {
        NavState.SetCourse(c.Id, c.Name);
        Nav.NavigateTo($"/teacher/course/{c.Id}");
    }

    private void EditCourse(int id)
    {
        Nav.NavigateTo($"/teacher/course/edit/{id}");
    }

    protected override async Task OnInitializedAsync()
    {
        NavState.ClearCourse();
        NavState.ClearModule();
        NavState.ClearActivity();

        try
        {
            isLoading = true;
            var courses = await CourseService.GetCoursesAsync();
            CoursesList = courses.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading courses: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}

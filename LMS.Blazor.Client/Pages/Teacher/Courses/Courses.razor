@page "/teacher/course"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Components.Cards
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Components.Common
@using Microsoft.AspNetCore.Authorization
@inject ICourseService CourseService
@inject NavigationManager Nav
@inject NavigationStateService NavState
@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <h2 class="fw-bold text-course mb-0">Available Courses</h2>
                    </div>
                    <div>
                        <button type="button"
                                class="btn btn-primary d-flex align-items-center px-3 py-2 shadow-sm"
                                @onclick="CreateNewCourse"
                                disabled="@isLoading">
                            <i class="bi bi-plus-circle me-2"></i>New Course
                        </button>
                    </div>
                </div>
            </div>

            <Loading Show="@isLoading" Message="Loading courses..." />

            @if (!isLoading)
            {
                @if (CoursesList != null && CoursesList.Any())
                {
                    <div class="row">
                        @foreach (var c in CoursesList)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <CourseCard Course="c"
                                            OnOpen="OpenCourse"
                                            OnEdit="EditCourse" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="text-muted">
                            <i class="bi bi-journal-x display-1 mb-3 opacity-50"></i>
                            <h5 class="fw-normal">No courses available yet</h5>
                            <p class="mb-4">Create your first course to get started!</p>
                            <button type="button"
                                    class="btn btn-primary d-flex align-items-center mx-auto px-3 py-2"
                                    @onclick="CreateNewCourse">
                                <i class="bi bi-plus-circle me-2"></i>Create Your First Course
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<CourseVM> CoursesList = new();
    private bool isLoading = true;

    private void OpenCourse(CourseVM c)
    {
        NavState.SetCourse(c.Id, c.Name);
        Nav.NavigateTo($"/teacher/course/{c.Id}");
    }

    private void EditCourse(int id)
    {
        Nav.NavigateTo($"/teacher/course/edit/{id}");
    }

    private void CreateNewCourse()
    {
        Nav.NavigateTo("/teacher/course/new");
    }

    protected override async Task OnInitializedAsync()
    {
        NavState.ClearCourse();
        NavState.ClearModule();
        NavState.ClearActivity();
        try
        {
            isLoading = true;
            var courses = await CourseService.GetCoursesAsync();
            CoursesList = courses.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading courses: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
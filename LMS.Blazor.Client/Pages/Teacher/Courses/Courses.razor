@page "/teacher/courses"
@using LMS.Blazor.Client.Services
@inject NavigationManager Nav
@inject NavigationStateService NavState

<div class="row">
    @foreach (var m in CoursesList)
    {
        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
            <div class="card h-100 shadow-sm hover-card" style="border-radius: 0.8rem; transition: all 0.3s ease;">
                <!-- Card Content (clickable area) -->
                <div class="card-body d-flex flex-column p-4" style="cursor: pointer;"
                     @onclick="() => OpenCourse(m.Id)">
                    <h5 class="card-title fw-bold mb-3 border-bottom pb-2" style="color: #1b6ec2;">
                        @m.Title
                    </h5>
                    <p class="card-text flex-grow-1" style="min-height: 60px; overflow: hidden;">
                        @m.Description
                    </p>
                    <div class="mt-auto pt-3">
                        <div class="bg-light rounded p-2 position-relative">
                            <small class="text-muted">
                                <strong>📅 Start:</strong> @m.StartDate<br>
                                <strong>🏁 End:</strong> @m.EndDate
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private record CourseVm(int Id, string Title, string Description, DateTime StartDate, DateTime EndDate);

    private List<CourseVm> CoursesList = new()
    {
        new(1, "C# Fundamentals", "Learn the basics of C#", DateTime.Parse("2025-08-14"), DateTime.Parse("2025-09-05")),
        new(2, "Web Development", "Front-end and back-end development", DateTime.Parse("2025-09-08"), DateTime.Parse("2025-10-01")),
        new(3, "Data Science", "Data analysis and machine learning", DateTime.Parse("2025-10-05"), DateTime.Parse("2025-10-29"))
    };

    // private void OpenModule(ModuleVm m)
    // {
    //     NavState.SetModule(m.Id, m.Title);
    //     Nav.NavigateTo($"/student/course/module/{m.Id}");
    // }

    private void OpenCourse(int id) => Nav.NavigateTo($"/teacher/course/{id}");

    // private void CreateNew() => Nav.NavigateTo("/teacher/course/create");

    // private void EditCourse(int id) => Nav.NavigateTo($"/teacher/course/edit/{id}");

    // private async Task DeleteCourse(int id)

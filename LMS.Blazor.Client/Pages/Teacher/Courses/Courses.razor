@page "/teacher/courses"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Components.Cards
@using LMS.Blazor.Client.Services
@inject NavigationManager Nav
@inject NavigationStateService NavState

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-5 text-center">
                <h2 class="fw-bold text-primary">Available Courses</h2>
                <p class="text-muted">Browse, manage and edit your courses</p>
            </div>

            <div class="row">
                @foreach (var c in CoursesList)
                {
                    <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                        <CourseCard Course="c"
                                    OnOpen="OpenCourse"
                                    OnEdit="EditCourse" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<CourseVM> CoursesList = new()
    {
        new CourseVM { Id = 1, Title = "C# Fundamentals", Description = "Learn the basics of C#", StartDate = DateTime.Parse("2025-08-14"), EndDate = DateTime.Parse("2025-09-05") },
        new CourseVM { Id = 2, Title = "Web Development", Description = "Front-end and back-end development", StartDate = DateTime.Parse("2025-09-08"), EndDate = DateTime.Parse("2025-10-01") },
        new CourseVM { Id = 3, Title = "Data Science", Description = "Data analysis and machine learning", StartDate = DateTime.Parse("2025-10-05"), EndDate = DateTime.Parse("2025-10-29") }
    };

    private void OpenCourse(CourseVM c)
    {
        NavState.SetCourse(c.Id, c.Title);
        Nav.NavigateTo($"/teacher/course/{c.Id}");
    }

    private void EditCourse(int id)
    {
        Nav.NavigateTo($"/teacher/course/edit/{id}");
    }

    protected override void OnInitialized()
    {
        NavState.ClearCourse();
        NavState.ClearModule();
        NavState.ClearActivity();
    }
}


@page "/teacher/courses"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Services
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Nav
@inject NavigationStateService NavState

@attribute [Authorize(Roles = "Teacher")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">

            <!-- Header -->
            <div class="mb-5">
                <h2 class="fw-bold text-primary">Courses</h2>
                <p class="text-muted">Browse and manage all your courses.</p>
            </div>

            <div class="row">
                @foreach (var c in CoursesList)
                {
                    <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                        <div class="card h-100 shadow-sm hover-card" style="border-radius: 0.8rem; transition: all 0.3s ease;">
                            <div class="card-body d-flex flex-column p-4" style="cursor: pointer;" @onclick="() => OpenCourse(c)">
                                <h5 class="card-title fw-bold mb-3 border-bottom pb-2 text-primary">@c.Title</h5>
                                <p class="card-text flex-grow-1">@c.Description</p>
                                <div class="mt-auto pt-3">
                                    <div class="bg-light rounded p-2 position-relative">
                                        <small class="text-muted">
                                            <strong>📅 Start:</strong> @c.StartDate.ToShortDateString()<br />
                                            <strong>🏁 End:</strong> @c.EndDate.ToShortDateString()
                                        </small>
                                        <button class="btn btn-sm btn-outline-primary position-absolute top-50 end-0 translate-middle-y me-2"
                                                @onclick="(e) => EditCourse(c.Id)"
                                                @onclick:stopPropagation="true">
                                            <span class="bi bi-pencil"></span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@code {
    private record CourseVm(int Id, string Title, string Description, DateTime StartDate, DateTime EndDate);

    private List<CourseVm> CoursesList = new()
    {
        new(1, "C# Fundamentals", "Learn the basics of C#", DateTime.Parse("2025-08-14"), DateTime.Parse("2025-09-05")),
        new(2, "Web Development", "Front-end and back-end dev", DateTime.Parse("2025-09-08"), DateTime.Parse("2025-10-01")),
        new(3, "Data Science", "Analysis and machine learning", DateTime.Parse("2025-10-05"), DateTime.Parse("2025-10-29"))
    };

    private void OpenCourse(CourseVm c)
    {
        NavState.SetCourse(c.Id, c.Title);
        Nav.NavigateTo($"/teacher/course/{c.Id}");
    }

    private void EditCourse(int id)
    {
        Nav.NavigateTo($"/teacher/course/edit/{id}");
    }

    protected override void OnInitialized()
    {
        NavState.ClearCourse();
        NavState.ClearModule();
        NavState.ClearActivity();
    }
}

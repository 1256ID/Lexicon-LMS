@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Components.Cards
@inject NavigationManager Nav
@inject NavigationStateService NavState

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-5 text-center">
                <h2 class="fw-bold text-primary">Available Courses</h2>
                <p class="text-muted">Browse, manage and edit your courses</p>
            </div>

            <div class="row">
                @foreach (var m in ModulesList)
                {
                    <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                        <ModuleCard Module="m"
                                    OnOpen="OpenModule"/>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private List<ModuleVM> ModulesList = new()
    {
        new ModuleVM {Id= 1, Title= "Introduction", Description= "Intro to course", StartDate= DateTime.Parse("2025-08-14"), EndDate= DateTime.Parse("2025-08-20")},
        new ModuleVM {Id= 2, Title= "C# Basics", Description= "Learn C#", StartDate= DateTime.Parse("2025-08-21"), EndDate= DateTime.Parse("2025-08-28")},
        new ModuleVM {Id= 3, Title= "Web API", Description= "APIs in depth", StartDate= DateTime.Parse("2025-08-29"), EndDate= DateTime.Parse("2025-09-05")}
    };

    private void OpenModule(ModuleVM m)
    {
        NavState.SetModule(m.Id, m.Title);
        Nav.NavigateTo($"/student/course/module/{m.Id}");
    }
}

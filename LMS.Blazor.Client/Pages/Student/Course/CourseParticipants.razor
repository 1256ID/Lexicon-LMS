@page "/student/courses/{CourseId:int}/participants"
@rendermode InteractiveWebAssembly
@inject HttpClient HttpClient
@inject NavigationManager Navigation

@using LMS.Blazor.Client.Components.Participants
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@attribute [Authorize(Roles = "Student")]

<AuthorizeView Roles="Student">
    <Authorized>
        <div class="content">
            <!-- Page Header -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold text-primary mb-1">Course Participants</h2>
                            <p class="text-muted mb-0">
                                <button class="btn btn-link p-0 text-decoration-none" @onclick="GoBack">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Course
                                </button>
                                @if (courseName != null)
                                {
                                    <span class="mx-2">•</span>
                                    <span>@courseName</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10">
                    <CourseParticipantsStudent CourseId="@CourseId" CurrentUserId="@currentUserId" />
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="content">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Access Denied</h4>
                <p>You must be logged in as a Student to access this page.</p>
                <hr>
                <p class="mb-0">Please <a href="/login" class="alert-link">login</a> with your student credentials.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int CourseId { get; set; }
    
    private string? courseName;
    private int currentUserId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetCurrentUser();
        await LoadCourseInfo();
    }

    private async Task GetCurrentUser()
    {
        if (AuthenticationStateTask != null)
        {
            var authState = await AuthenticationStateTask;
            var userIdClaim = authState.User.FindFirst("sub") ?? authState.User.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
            {
                currentUserId = userId;
            }
        }
    }

    private async Task LoadCourseInfo()
    {
        try
        {
            var response = await HttpClient.GetAsync($"/api/courses/{CourseId}");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var course = JsonSerializer.Deserialize<CourseInfoDto>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
                courseName = course?.Name;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading course info: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/student/courses/{CourseId}");
    }

    public class CourseInfoDto
    {
        public string Name { get; set; } = "";
    }
}
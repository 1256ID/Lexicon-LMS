@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = "Student")]

<StudentCourseTabs />

<div class="row g-3">
    <div class="col-md-3">
        <div class="card">
            <div class="card-header">Course Documents</div>
            <ul class="list-group list-group-flush">
                @foreach (var d in Docs)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@d.Title</span>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => Select(d.Id)">View</button>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card h-100">
            <div class="card-header">Preview</div>
            <div class="card-body">
                @if (SelectedDoc is null)
                {
                    <em>Select a document…</em>
                }
                else
                {
                    <h5>@SelectedDoc.Title</h5>
                    <p class="text-muted">(@SelectedDoc.FileName)</p>
                    <hr />
                    <p>Here you render the document viewer (pdf/embed/markdown etc.).</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private record DocVm(int Id, string Title, string FileName);
    private List<DocVm> Docs = new()
    {
        new(10, "Syllabus", "course-syllabus.pdf"),
        new(11, "Setup Guide", "setup.md"),
        new(12, "Project Brief", "project.pdf")
    };

    private DocVm? SelectedDoc;

    private void Select(int id) => SelectedDoc = Docs.First(x => x.Id == id);
}


@page "/student/course"
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Student")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">

            <!-- Course Header -->
            <div class="mb-4">
                <h2 class="fw-bold text-primary">Beginner’s Guide to Mastering UI/UX Design</h2>
                <p class="text-muted">
                    <i class="bi bi-calendar-event me-2 text-secondary"></i>
                    Start: 2025/08/14
                </p>
            </div>

            <!-- Tabs (Always Visible) -->
            <div class="d-flex gap-2 flex-wrap justify-content-center mb-3">
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Modules ? "active" : "")"
                        @onclick="() => SelectTab(Tab.Modules)">
                    Modules
                </button>
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")"
                        @onclick="() => SelectTab(Tab.Documents)">
                    Documents
                </button>
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Participants ? "active" : "")"
                        @onclick="() => SelectTab(Tab.Participants)">
                    Participants
                </button>
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Schedule ? "active" : "")"
                        @onclick="() => SelectTab(Tab.Schedule)">
                    Schedule
                </button>
            </div>

            <!-- Tab Content (Conditional Rendering) -->
            <div class="tab-content">
                @switch (SelectedTab)
                {
                    case Tab.Modules:
                        <CourseModules />
                        break;
                    case Tab.Documents:
                        <CourseDocuments />
                        break;
                    case Tab.Participants:
                        <CourseParticipants />
                        break;
                    case Tab.Schedule:
                        <CourseSchedule />
                        break;
                }
            </div>

        </div>
    </div>
</div>

@code {
    private enum Tab { Modules, Documents, Participants, Schedule }

    private Tab SelectedTab = Tab.Modules; // default tab

    private void SelectTab(Tab tab)
    {
        SelectedTab = tab;
    }
}

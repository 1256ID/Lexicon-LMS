@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Components.Cards
@using LMS.Blazor.Client.Services.Interfaces
@using LMS.Blazor.Client.Components.Common
@using Microsoft.AspNetCore.Authorization
@inject IModuleService ModuleService
@inject NavigationManager Nav
@inject NavigationStateService NavState
@attribute [Authorize(Roles = "Student")]

<Loading Show="@isLoading" Message="Loading modules..." />


@if(!isLoading)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="row">
                    @foreach (var m in ModulesList)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                            <ModuleCard Module="m"
                                        OnOpen="OpenModule" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public int CourseId { get; set; }

    private List<ModuleVM>? ModulesList;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var modules = await ModuleService.GetModulesByCourseIdAsync(CourseId);
            ModulesList = modules.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading modules: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenModule(ModuleVM m)
    {
        NavState.SetModule(m.Id, m.Name);
        Nav.NavigateTo($"/student/course/module/{m.Id}");
    }

}


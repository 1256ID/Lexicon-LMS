@page "/student/course"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Components.Participants
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject ICourseService CourseService
@inject NavigationStateService NavState
@attribute [Authorize(Roles = "Student")]

<Loading Show="@isLoading" Message="Loading course..." />

@if (!isLoading)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-10 mx-auto">

                <div class="mb-4">
                    <h2 class="fw-bold text-primary">@StudentCourse?.Name ?? "Course"</h2>
                    <p class="text-muted">
                        <i class="bi bi-calendar-event me-2 text-secondary"></i>
                        Start: @StudentCourse?.StartDate.ToString("yyyy/MM/dd")
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap justify-content-center mb-5">
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.Modules ? "active" : "")" @onclick="() => SelectTab(Tab.Modules)">Modules</button>
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")" @onclick="() => SelectTab(Tab.Documents)">Documents</button>
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.Participants ? "active" : "")" @onclick="() => SelectTab(Tab.Participants)">Participants</button>
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.Schedule ? "active" : "")" @onclick="() => SelectTab(Tab.Schedule)">Schedule</button>
                </div>

                <div class="tab-content">
                    @switch (SelectedTab)
                    {
                        case Tab.Modules:
                            <CourseModulesStudent CourseId="@StudentCourse.Id" />
                            break;
                        case Tab.Documents:
                            <CourseDocumentsStudent CourseId="@StudentCourse.Id" />
                            break;
                        case Tab.Participants:
                            <CourseParticipantsStudent CourseId="@StudentCourse.Id" />
                            break;
                        case Tab.Schedule:
                            <CourseScheduleStudent CourseId="@StudentCourse.Id" />
                            break;
                    }
                </div>

            </div>
        </div>
    </div>
}

@code {
    private int CourseId = 1;
    private CourseVM StudentCourse;
    private enum Tab { Modules, Documents, Participants, Schedule }
    private Tab SelectedTab = Tab.Modules;
    private bool isLoading = true;

    private void SelectTab(Tab tab) => SelectedTab = tab;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            NavState.ClearModule();
            StudentCourse = await CourseService.GetCourseByIdAsync(CourseId);
        }
        finally
        {
            isLoading = false;
        }
    }
}

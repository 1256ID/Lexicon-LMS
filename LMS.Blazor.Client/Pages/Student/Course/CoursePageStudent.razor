@page "/student/course"

@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Components.Info
@using LMS.Blazor.Client.Components.Participants
@using LMS.Blazor.Client.Components.Tabs
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject ICourseService CourseService
@inject NavigationStateService NavState
@attribute [Authorize(Roles = "Student")]

<!-- Loading component -->
<Loading Show="@isLoading" Message="Loading course..." />

@if (!isLoading)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="mb-4">
                    <h2 class="fw-bold text-course">@StudentCourse?.Name</h2>
                    <p class="text-muted">
                        <i class="bi bi-calendar-event me-2 text-secondary"></i>
                        Start: @StudentCourse?.StartDate.ToString("yyyy/MM/dd")
                    </p>
                </div>

                <!-- Tab Navigation Component -->
                <TabNavigation TTabType="Tab"
                               SelectedTab="SelectedTab"
                               OnTabChanged="OnTabChanged"
                               Buttons="TabButtons" />

                <!-- Tab Content -->
                <div class="tab-content">
                    @switch (SelectedTab)
                    {
                        case Tab.Info:
                            <Info CourseId="@StudentCourse.Id" />
                            break;
                        case Tab.Modules:
                            <CourseModulesStudent CourseId="@StudentCourse.Id" />
                            break;
                        case Tab.Documents:
                            <CourseDocumentsStudent CourseId="@StudentCourse.Id" />
                            break;
                        case Tab.Participants:
                            <CourseParticipantsStudent CourseId="@StudentCourse.Id" />
                            break;
                        case Tab.Schedule:
                            <CourseScheduleStudent CourseId="@StudentCourse.Id" />
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int CourseId = 1;
    private CourseVM StudentCourse;

    // Tab enumeration for course navigation
    private enum Tab { Info, Modules, Documents, Participants, Schedule }
    private Tab SelectedTab = Tab.Modules; // Start with Modules tab

    private bool isLoading = true;

    // Tab button configuration for the navigation component
    private List<TabNavigation<Tab>.TabButton<Tab>> TabButtons = new()
    {
        new() { Label = "Info", TabValue = Tab.Info },
        new() { Label = "Modules", TabValue = Tab.Modules },
        new() { Label = "Documents", TabValue = Tab.Documents },
        new() { Label = "Participants", TabValue = Tab.Participants },
        new() { Label = "Schedule", TabValue = Tab.Schedule }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            NavState.ClearModule();
            StudentCourse = await CourseService.GetCourseByIdAsync(CourseId);
        }
        finally
        {
            isLoading = false;
        }
    }

    // Handle tab change event from navigation component
    private async Task OnTabChanged(Tab newTab)
    {
        SelectedTab = newTab;
    }
}


@page "/student/overview"

@rendermode InteractiveWebAssembly
@inject HttpClient HttpClient

@using System.Text.Json
@using LMS.Blazor.Client.Components.Overviews
@using LMS.Blazor.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@attribute [Authorize]

<AuthorizeView Roles="Student">
    <Authorized>
        <div class="content">
            <!-- Hero Section -->
            <HeroSection WelcomeMessage="@($"Welcome, {context.User.Identity?.Name}")" 
                         ShowRightSection="false" />

            <!-- Main Content -->
            <div class="row">
                <div class="col-12">
                    <!-- Upcoming Schedule with component -->
                    <UpcomingDeadLines Title="Upcoming Schedule"
                                       IconClass="bi-calendar-event"
                                       Items="@GetUpcomingScheduleList()"
                                       IsListFormat="true"
                                       GetItemTitle="@GetScheduleTitle"
                                       GetItemSubtitle="@GetScheduleSubtitle"
                                       GetItemDate="@GetScheduleDate"
                                       GetBadgeClass="@GetScheduleBadgeClass"
                                       EmptyMessage="No upcoming schedule"
                                       EmptyIcon="bi-calendar-check" />
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="content">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Access Denied</h4>
                <p>You must be logged in as a Student to access this page.</p>
                <hr>
                <p class="mb-0">Please <a href="/login" class="alert-link">login</a> with your student credentials.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>


@code {
    private StudentOverviewDto? studentData;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewData();
    }

    private async Task LoadOverviewData()
    {
        try
        {
            isLoading = true;

            // API endpoint to get student overview data
            var response = await HttpClient.GetAsync("/api/student/overview");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                studentData = JsonSerializer.Deserialize<StudentOverviewDto>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
            }
            else
            {
                // Error case
                Console.WriteLine($"Failed to load overview data: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            // Handle exception
            Console.WriteLine($"Error loading overview data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Methods for the UpcomingDeadlines component
    private IEnumerable<object> GetUpcomingScheduleList()
    {
        return studentData?.UpcomingSchedule?.Cast<object>() ?? new List<object>();
    }

    private string GetScheduleTitle(object item)
    {
        return ((ScheduleItemDto)item).Title;
    }

    private string GetScheduleSubtitle(object item)
    {
        return ((ScheduleItemDto)item).Description;
    }

    private DateTime? GetScheduleDate(object item)
    {
        return ((ScheduleItemDto)item).Date;
    }

    private string GetScheduleBadgeClass(object item)
    {
        var schedule = (ScheduleItemDto)item;
        var daysUntil = (schedule.Date - DateTime.Today).TotalDays;
        
        if (daysUntil <= 1) return "bg-danger";
        if (daysUntil <= 3) return "bg-warning";
        return "bg-primary";
    }

    // DTO Classes for API response
    public class StudentOverviewDto
    {
        public List<ScheduleItemDto> UpcomingSchedule { get; set; } = new();
    }

    public class ScheduleItemDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public string Type { get; set; } = string.Empty;
    }
}




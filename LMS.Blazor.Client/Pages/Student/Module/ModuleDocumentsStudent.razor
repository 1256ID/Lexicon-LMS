@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = "Student")]
@using LMS.Blazor.Client.Components.Common

<Loading Show="@isLoading" Message="Loading documents..." />

@if (!isLoading)
{
    <h3>Documents for Module @ModuleId</h3>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header">Module Documents</div>
                <ul class="list-group list-group-flush">
                    @foreach (var d in Docs)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@d.Title</span>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => Select(d.Id)">View</button>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-md-9">
            <div class="card h-100">
                <div class="card-header">Preview</div>
                <div class="card-body">
                    @if (SelectedDoc is null)
                    {
                        <em>Select a document…</em>
                    }
                    else
                    {
                        <h5>@SelectedDoc.Title</h5>
                        <p class="text-muted">(@SelectedDoc.FileName)</p>
                        <hr />
                        <p>Here you render the document viewer (pdf/embed/markdown etc.).</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ModuleId { get; set; }

    private record DocVm(int Id, string Title, string FileName);
    private List<DocVm> Docs = new();
    private DocVm? SelectedDoc;
    private bool isLoading = true;

    protected override void OnInitialized()
    {
        try
        {
            isLoading = true;
            // Dummy data för demo, byt mot API-anrop om du vill
            Docs = ModuleId switch
            {
                1 => new() { new(10, "Intro Syllabus", "intro-syllabus.pdf"), new(11, "Welcome Guide", "welcome.md") },
                2 => new() { new(20, "C# Basics Notes", "csharp-basics.pdf"), new(21, "Exercises", "csharp-exercises.docx") },
                3 => new() { new(30, "Web API Guide", "webapi.pdf"), new(31, "Postman Collection", "api-collection.json") },
                _ => new()
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Documents: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Select(int id) => SelectedDoc = Docs.FirstOrDefault(x => x.Id == id);
}

@using LMS.Blazor.Client.Components.Common
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Services.Implementations
@inject IActivityService ActivityService
@inject NavigationStateService NavState

<Loading Show="@isLoading" Message="Loading activity content..." />

@if (!isLoading)
{
    <div class="card">
        <div class="card-header">Activity View</div>
        <div class="card-body">
            <h5>Activity @ActivityId</h5>
            <p>This is the main content for the activity.</p>
        </div>
    </div>
}

@code {
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }

    private bool isLoading = true;
    private string ActivityName = string.Empty;
    private string ActivityDescription = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var activity = await ActivityService.GetActivityByIdAsync(ActivityId);
            ActivityName = activity?.Name ?? $"Activity {ActivityId}";
            ActivityDescription = activity?.Description ?? "No description available.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading activity view: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}

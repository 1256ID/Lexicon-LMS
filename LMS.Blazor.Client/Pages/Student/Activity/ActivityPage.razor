@page "/student/course/module/{ModuleId:int}/activity/{ActivityId:int}"
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using LMS.Blazor.Client.Services
@inject NavigationStateService NavState

@attribute [Authorize(Roles = "Student")]

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">

            <!-- Activity Header -->
            <div class="mb-4">
                <h2 class="fw-bold text-primary">Activity details</h2>
                <p class="text-muted">
                    <i class="bi bi-calendar-event me-2 text-secondary"></i>
                    Start: 2025/09/18
                </p>
            </div>

            <!-- Tabs -->
            <div class="d-flex gap-2 flex-wrap justify-content-center mb-5">
                <button class="btn btn-outline-primary @(SelectedTab == Tab.View ? "active" : "")"
                        @onclick="() => SelectTab(Tab.View)">
                    View
                </button>
                <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")"
                        @onclick="() => SelectTab(Tab.Documents)">
                    Documents
                </button>
            </div>

            <!-- Tab Content -->
            <div class="tab-content">
                @switch (SelectedTab)
                {
                    case Tab.View:
                        <ActivityView ModuleId="@ModuleId" ActivityId="@ActivityId" />
                        break;
                    case Tab.Documents:
                        <ActivityDocuments ModuleId="@ModuleId" ActivityId="@ActivityId" />
                        break;
                }
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }

    private enum Tab { View, Documents }
    private Tab SelectedTab = Tab.View; // default tab

    protected override void OnInitialized()
    {
        var moduleName = NavState.CurrentModuleName ?? $"Module {ModuleId}";
        var activityName = NavState.CurrentActivityName ?? $"Activity {ActivityId}";
        NavState.SetActivity(ModuleId, moduleName, ActivityId, activityName);
    }

    private void SelectTab(Tab tab) => SelectedTab = tab;
}

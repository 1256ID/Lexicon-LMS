@page "/student/course/module/{ModuleId:int}/activity/{ActivityId:int}"
@rendermode InteractiveWebAssembly
@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Components.Common
@using Microsoft.AspNetCore.Authorization
@inject IActivityService ActivityService
@inject IModuleService ModuleService
@inject NavigationStateService NavState
@inject NavigationManager Nav
@attribute [Authorize(Roles = "Student")]

<Loading Show="@isLoading" Message="Loading activity..." />

@if (!isLoading)
{
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-10 mx-auto">

                <div class="mb-4">
                    <h2 class="fw-bold text-primary">@ActivityName</h2>
                    <p class="text-muted"><i class="bi bi-calendar-event me-2 text-secondary"></i> Start: @ActivityStartDate.ToString("yyyy/MM/dd")</p>
                </div>

                <div class="d-flex gap-2 flex-wrap justify-content-center mb-5">
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.View ? "active" : "")" @onclick="() => SelectTab(Tab.View)">View</button>
                    <button class="btn btn-outline-primary @(SelectedTab == Tab.Documents ? "active" : "")" @onclick="() => SelectTab(Tab.Documents)">Documents</button>
                </div>

                <div class="tab-content">
                    @switch (SelectedTab)
                    {
                        case Tab.View:
                            <ActivityViewStudent ModuleId="@ModuleId" ActivityId="@ActivityId" />
                            break;
                        case Tab.Documents:
                            <ActivityDocumentsStudent ModuleId="@ModuleId" ActivityId="@ActivityId" />
                            break;
                    }
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ModuleId { get; set; }
    [Parameter] public int ActivityId { get; set; }

    private enum Tab { View, Documents }
    private Tab SelectedTab = Tab.View;
    private bool isLoading = true;
    private string ActivityName;
    private DateTime ActivityStartDate;

    private void SelectTab(Tab tab) => SelectedTab = tab;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var module = await ModuleService.GetModuleByIdAsync(ModuleId);
            var activity = await ActivityService.GetActivityByIdAsync(ActivityId);
            ActivityName = activity?.Name ?? $"Activity {ActivityId}";
            ActivityStartDate = activity?.StartDate ?? DateTime.Today;
            NavState.SetActivity(ModuleId, module?.Name ?? $"Module {ModuleId}", ActivityId, ActivityName);
        }
        finally
        {
            isLoading = false;
        }
    }
}

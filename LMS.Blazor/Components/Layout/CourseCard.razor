@inject NavigationManager Navigation

<div class="col-lg-4 col-md-6 col-sm-12 mb-4">
    <div class="card h-100 shadow-sm hover-card course-card">
        <!-- Card Content (clickable area) -->
        <div class="card-body d-flex flex-column p-4 card-content" @onclick="GoToModules">
            <h5 class="card-title fw-bold mb-3 border-bottom pb-2 text-primary">
                Course name  <!-- @Course.Name-->
            </h5>
            <p class="card-text flex-grow-1 card-content">
                description  <!-- @Course.Description -->
            </p>
            <div class="mt-auto pt-3">
                <div class="bg-light rounded p-2 position-relative">
                    <small class="text-muted">
                        <strong>📅 Start:</strong> YYYY/MM/DD <!-- @Course.StartDate -->
                    </small>
                    <!-- Edit Icon for Teachers - Bottom Right -->
                    <AuthorizeView Roles="Teacher">
                        <Authorized>
                            <button class="btn btn-sm btn-outline-primary position-absolute top-50 end-0 translate-middle-y me-2 edit-btn"
                                    @onclick="GoToEditCourse"
                                    @onclick:stopPropagation="true"
                                    title="Edit Course">
                                <span class="bi-pencil-edit"></span>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>
</div>
